{
	"name": "obsidian-youtrack-fetcher",
	"version": "0.14.0",
	"description": "Obsidian plugin to fetch YouTrack issues into notes.",
	"main": "main.js",
	"scripts": {
		"dev": "node esbuild.config.mjs",
		"dev:watch": "node esbuild.config.mjs --watch",
		"prod": "node esbuild.config.mjs --production",
		"typecheck": "tsc -noEmit -skipLibCheck",
		"format": "prettier --write .",
		"test": "jest",
		"test:dev": "pnpm dev && jest",
		"test:watch": "pnpm dev && jest --watch",
		"coverage": "pnpm dev && jest --coverage",
		"lint": "eslint . --max-warnings 0",
		"lint:css": "stylelint \"src/**/*.css\" --max-warnings 0",
		"build": "pnpm typecheck && pnpm lint && pnpm lint:css && pnpm format && pnpm prod && pnpm test",
		"version": "node version-bump.mjs && git add manifest.json versions.json",
		"build:css": "esbuild src/styles.src.css --loader:.css=css --minify --outfile=styles.css",
		"release": "node release.mjs",
		"tag-release": "git tag $(node -p \"require('./package.json').version\") && git push origin --tags"
	},
	"keywords": [
		"obsidian",
		"plugin",
		"youtrack"
	],
	"author": "Forketyfork",
	"license": "MIT",
	"engines": {
		"node": "^22.13.0 || >=24"
	},
	"devDependencies": {
		"@codemirror/state": "6.7.5",
		"@codemirror/view": "6.43.12",
		"@eslint/js": "^10.0.1",
		"@eslint/json": "2.1.0",
		"@types/jest": "^30.0.0",
		"@types/lodash": "^4.17.25",
		"@types/node": "^26.6.2",
		"@typescript-eslint/eslint-plugin": "^8.70.0",
		"@typescript-eslint/parser": "^8.70.0",
		"esbuild": "^0.28.2",
		"eslint": "^10.11.0",
		"eslint-plugin-no-unsanitized": "^4.1.5",
		"eslint-plugin-obsidianmd": "^0.4.2",
		"globals": "^17.12.0",
		"jest": "^30.5.2",
		"jest-environment-jsdom": "^30.5.2",
		"obsidian": "^1.13.1",
		"prettier": "^3.9.8",
		"stylelint": "^17.15.0",
		"stylelint-config-obsidianmd": "^0.1.0",
		"ts-jest": "^29.4.12",
		"tslib": "^2.8.1",
		"typescript": "^6.0.3",
		"typescript-eslint": "^8.70.0"
	},
	"packageManager": "pnpm@11.1.2"
}
