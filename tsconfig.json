{
  "compilerOptions": {
    "inlineSourceMap": true,
    "inlineSources": true,
    "module": "ESNext",
    "target": "ES6",
    "allowJs": true,
    "noImplicitAny": true,
    "moduleResolution": "bundler",
    "importHelpers": true,
    "isolatedModules": true,
    "strictNullChecks": true,
    "types": [
      "jest",
      "node"
    ],
    "lib": [
      "DOM",
      "ES6"
		],
		"esModuleInterop": true
  },
  "include": [
		"**/*.ts"
  ]
}
